{
  "name": "stm32-git-manager",
  "version": "0.4.1",
  "description": "面向 STM32 / Keil 新手的中文可视化 Git 工程管理工具",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "package": "node scripts/package.cjs",
    "test:ui": "node scripts/d-ui-smoke.cjs",
    "test:startup": "node scripts/public-startup-smoke.cjs",
    "check:share": "node scripts/check-share.cjs",
    "package:zip": "node scripts/package-zip.cjs"
  },
  "dependencies": {
    "electron": "45.0.0",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "license": "MIT",
  "author": "1300282202",
  "repository": {
    "type": "git",
    "url": "https://github.com/1300282202/stm32-git-manager.git"
  },
  "homepage": "https://github.com/1300282202/stm32-git-manager#readme",
  "bugs": {
    "url": "https://github.com/1300282202/stm32-git-manager/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
